#!/usr/bin/env bash
# Runs kobo.py with the first Python 3.9+ it finds: Mac, Linux, and Git Bash on Windows
# (where "python3" may be the Microsoft Store stub, so every candidate is actually tried).
case "${BASH_SOURCE[0]}" in
  */*|*\\*) here="${BASH_SOURCE[0]%[/\\]*}" ;;
  *) here=. ;;
esac
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
for candidate in python3 python "py -3"; do
  # shellcheck disable=SC2086 # "py -3" is a command with its argument
  if command -v ${candidate%% *} >/dev/null 2>&1 &&
    $candidate -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec $candidate "$here/kobo.py" "$@"
  fi
done
echo "Для плагіна Kobo потрібен Python 3.9 або новіший, а на цьому комп'ютері його не знайдено." >&2
echo "Mac: встановіть Python з https://www.python.org/downloads/ (або в Терміналі: xcode-select --install)." >&2
echo "Windows: встановіть Python з https://www.python.org/downloads/ і поставте галочку «Add python.exe to PATH»." >&2
echo "Потім перезапустіть Claude Code." >&2
exit 3
